menu "G6 Brain Configuration"

    menu "RLS Optimizer"

        config RLS_LAMBDA_MIN
            int "Minimum RLS forgetting factor (x1000)"
            default 980
            range 900 999
            help
                Minimum effective forgetting factor.
                Value is multiplied by 0.001 (e.g. 985 = 0.985).

        config RLS_RIDGE_EPSILON
            int "RLS ridge regularization (x100000)"
            default 1
            range 0 100
            help
                Ridge regularization term added to P matrix diagonal.
                Value is multiplied by 1e-5.

        config RLS_TRACE_MAX
            int "Maximum trace of P matrix"
            default 1000000
            range 10000 10000000
            help
                Upper limit for trace(P) to consider the model valid.

    endmenu

    menu "Safety & Thermal"

        config TEMP_CEILING
            int "Thermal ceiling (°C)"
            default 70
            range 50 85
            help
                Maximum allowed chip temperature before proactive throttling.

        config NER_THRESHOLD
            int "NER threshold (x10)"
            default 25
            range 10 100
            help
                Non-Ergodic Rate threshold (in 0.1% units).
                Example: 25 = 2.5%

    endmenu

    menu "Optimization Behavior"

        config DFS_STEP_MHZ
            int "DFS frequency step (MHz)"
            default 25
            range 5 50
            help
                Frequency step size used during optimization.

    endmenu

endmenu
