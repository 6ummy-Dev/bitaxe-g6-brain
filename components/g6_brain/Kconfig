# G6 Brain Configuration — v1.0.0-beta2 (Phase 0 — fully wired for code)

menu "G6 Brain Configuration"

    menu "RLS Optimizer"

        config G6_RLS_LAMBDA_MIN
            int "Minimum RLS forgetting factor (x1000)"
            default 950
            range 900 999
            help
                Minimum effective forgetting factor for Variable Forgetting Factor.
                Value ÷ 1000 → e.g. 950 = 0.950. Higher = more stable model.

        config G6_RLS_RIDGE_EPSILON
            int "RLS ridge regularization (x1e6)"
            default 10
            range 1 1000
            help
                Ridge term added to P-matrix diagonal (value × 1e-6). Prevents collapse.

        config G6_RLS_TRACE_MAX
            int "Maximum trace of P matrix"
            default 10000000
            range 100000 100000000
            help
                Upper limit for trace(P). Exceeding forces conservative/cold-start mode.

    endmenu

    menu "Safety & Thermal"

        config G6_TEMP_CEILING
            int "Thermal ceiling temperature (°C)"
            default 70
            range 50 85
            help
                Hard ASIC temperature limit. Proactive derating triggers near this value.

        config G6_NER_THRESHOLD
            int "NER (nonce error rate) threshold (x100)"
            default 250
            range 50 2000
            help
                Nonce Error Rate threshold in 0.01% units (250 = 2.5%). Triggers back-off.

    endmenu

    menu "Optimization Behavior"

        config G6_DFS_STEP_MHZ
            int "DFS frequency step size (MHz)"
            default 25
            range 5 50
            help
                Step size used for optimization suggestions and slew limiting.

    endmenu

endmenu
